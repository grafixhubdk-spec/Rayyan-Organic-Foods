rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Product catalogue is public to read; only verified admins can change it.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Customers can submit orders; only admins can read or update them.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['customerName','phone','address','items','status','createdAt'])
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.status == 'Pending';
      allow read, update, delete: if isAdmin();
    }

    // Each admin can read only their own role document.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }
  }
}
